# Variables de Entorno para Physics Class Analyzer

# Proveedor por defecto: mock | ollama | openai
LLM_PROVIDER=mock

# Configuración OpenAI (opcional si usas openai)
OPENAI_API_KEY=tu_api_key_aqui
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Configuración Ollama (opcional si usas ollama local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
